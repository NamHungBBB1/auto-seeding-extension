{
    "manifest_version": 3,
    "name": "FB Auto Seeding",
    "version": "1.0",
    "description": "Auto Like & Comment AI step by step",
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/AnnHome.VN",
                "https://www.facebook.com/annhome.careers"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}